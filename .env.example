# NSCLC Insight Engine — 환경변수
# 사용: cp .env.example .env
# 실제 .env는 git 제외 (.gitignore)

# ===== AWS =====
# EC2 인스턴스 프로필 (NSCLCSupervisorEC2Profile) 사용 시 자격증명 자동
# 로컬 dev에선 ~/.aws/credentials 사용 또는 KEY/SECRET 채움
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ===== Bedrock =====
BEDROCK_REGION=us-east-1
BEDROCK_KB_ID=PHZTHHSMZC
GUARDRAIL_ID=19ys87squ5mz
GUARDRAIL_VERSION=9

# ===== Data (Lambda + supervisor 공통) =====
DATA_MODE=s3
S3_DATA_BUCKET=say2-5team-use1
S3_DATA_PREFIX=nsclc-insight-engine

# ===== Supervisor routing =====
# false: AWS Lambda invoke (drug_library 제외) — EC2 운영 모드
# true:  모든 lambda local invoke — 로컬 dev
SUPERVISOR_LOCAL_MODE=false
LOCAL_ONLY_LAMBDAS=drug_library_lambda

# ===== UI ↔ Supervisor =====
# docker compose 내부 DNS — 변경 불필요
SUPERVISOR_URL=http://supervisor:8000
SUPERVISOR_HTTP_TIMEOUT=300
SUPERVISOR_STREAM_TIMEOUT=600

# ===== 기타 =====
LOG_LEVEL=info
NSCLC_GUARDRAIL_VERSION=9
NSCLC_SUPERVISOR_MOCK=0
